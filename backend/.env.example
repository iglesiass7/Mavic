# Para correr el backend o los tests FUERA de Docker (desde tu PC, con la base
# levantada por docker compose). Copiá este archivo como backend/.env

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mavic:mavic@localhost:5432/mavic
TEST_DATABASE_URL=postgresql+psycopg://mavic:mavic@localhost:5432/mavic_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCS_ENABLED=true
