# Para correr el backend o los tests FUERA de Docker (desde tu PC, con la base
# levantada por docker compose). Copiá este archivo como backend/.env

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mavic:mavic@localhost:5432/mavic
TEST_DATABASE_URL=postgresql+psycopg://mavic:mavic@localhost:5432/mavic_test
CORS_ALLOWED_ORIGINS=http://localhost:3000
DOCS_ENABLED=true

# Sesión: en un servidor con HTTPS, SESSION_COOKIE_SECURE tiene que ser true.
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AGENT_TOOLS_TOKEN=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_BRANCH_ID=

# Avisos por email (ADR-038). En tu PC, sin Docker, podés usar Mailpit o cualquier
# SMTP de prueba. Sin SMTP_HOST o SMTP_FROM, el canal email está apagado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Avisos por WhatsApp (Twilio). Sin los tres, el canal está apagado.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
