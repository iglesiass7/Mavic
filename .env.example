# Copiá este archivo como `.env` solo si querés cambiar algún valor.
# Sin .env, docker compose usa estos mismos valores por defecto.
# El archivo .env NUNCA se sube a git (está en .gitignore).

POSTGRES_USER=mavic
POSTGRES_PASSWORD=mavic
POSTGRES_DB=mavic
POSTGRES_PORT=5432

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- agente de voz
# Token que el agente de ElevenLabs manda en cada herramienta. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y pasáselo a quien configura el agente (por un canal privado, no por el repo).
AGENT_TOOLS_TOKEN=
# Secreto que muestra ElevenLabs al crear el webhook de fin de llamada.
ELEVENLABS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- llamadas por teléfono
# Botón "Llamar" del caso: Mavic le pide a ElevenLabs que llame al deudor por
# Twilio. Se sacan del panel de ElevenLabs (quien configura el agente los sabe).
# La clave de la API es SECRETA: nunca en el repo ni en un chat público.
ELEVENLABS_API_KEY=
# Id del agente "Gestión de Deuda" (agent_...).
ELEVENLABS_AGENT_ID=
# Id del número de teléfono vinculado al agente (Phone Numbers en ElevenLabs).
ELEVENLABS_PHONE_NUMBER_ID=
# Rama del agente para pruebas. Vacío: la rama publicada.
ELEVENLABS_BRANCH_ID=

# ---------------------------------------------------------------- avisos por email (ADR-038)
# Sin tocar nada, los emails van a Mailpit (http://localhost:8025): NO salen a
# internet, sirven para probar. Para mandar de verdad, completá estos datos.
#
# Gmail (para probar con una cuenta propia): activá la verificación en 2 pasos y
# creá una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   SMTP_USERNAME=tu.cuenta@gmail.com  SMTP_PASSWORD=(la contraseña de aplicación)
# AWS SES (producción): SMTP_HOST=email-smtp.<región>.amazonaws.com, puerto 587,
#   usuario y clave SMTP que da SES (no son las claves de la consola).
# La contraseña es SECRETA: nunca en el repo ni en un chat público.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente que ve el deudor, con nombre: "FibraSur <avisos@fibrasur.com>"
SMTP_FROM=

# ---------------------------------------------------------------- avisos por WhatsApp (Twilio)
# Del panel de Twilio (Account Info). El token es SECRETO.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# El número de WhatsApp de Twilio. En el sandbox de prueba: +14155238886
TWILIO_WHATSAPP_FROM=
