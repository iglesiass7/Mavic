# Copiá este archivo como `.env` solo si querés cambiar algún valor.
# Sin .env, docker compose usa estos mismos valores por defecto.
# El archivo .env NUNCA se sube a git (está en .gitignore).

POSTGRES_USER=mavic
POSTGRES_PASSWORD=mavic
POSTGRES_DB=mavic
POSTGRES_PORT=5432

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- agente de voz
# Token que el agente de ElevenLabs manda en cada herramienta. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y pasáselo a quien configura el agente (por un canal privado, no por el repo).
AGENT_TOOLS_TOKEN=
# Secreto que muestra ElevenLabs al crear el webhook de fin de llamada.
ELEVENLABS_WEBHOOK_SECRET=
