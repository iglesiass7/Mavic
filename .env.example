# Copiá este archivo como `.env` solo si querés cambiar algún valor.
# Sin .env, docker compose usa estos mismos valores por defecto.
# El archivo .env NUNCA se sube a git (está en .gitignore).

POSTGRES_USER=mavic
POSTGRES_PASSWORD=mavic
POSTGRES_DB=mavic
POSTGRES_PORT=5432

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- agente de voz
# Token que el agente de ElevenLabs manda en cada herramienta. Generá uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y pasáselo a quien configura el agente (por un canal privado, no por el repo).
AGENT_TOOLS_TOKEN=
# Secreto que muestra ElevenLabs al crear el webhook de fin de llamada.
ELEVENLABS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- llamadas por teléfono
# Botón "Llamar" del caso: Mavic le pide a ElevenLabs que llame al deudor por
# Twilio. Se sacan del panel de ElevenLabs (quien configura el agente los sabe).
# La clave de la API es SECRETA: nunca en el repo ni en un chat público.
ELEVENLABS_API_KEY=
# Id del agente "Gestión de Deuda" (agent_...).
ELEVENLABS_AGENT_ID=
# Id del número de teléfono vinculado al agente (Phone Numbers en ElevenLabs).
ELEVENLABS_PHONE_NUMBER_ID=
# Rama del agente para pruebas. Vacío: la rama publicada.
ELEVENLABS_BRANCH_ID=
